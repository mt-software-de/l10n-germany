<odoo>
    <record id="view_l10n_de_tax_statement_form" model="ir.ui.view">
        <field name="model">l10n.de.tax.statement</field>
        <field
            name="inherit_id"
            ref="l10n_de_tax_statement.view_l10n_de_tax_statement_form"
        />
        <field name="arch" type="xml">
            <group name="tax_total" position="after">
                <separator
                    string="Zusammenfassende Meldung"
                    invisible="not zm_line_ids"
                />
                <field name="zm_line_ids" invisible="not zm_line_ids">
                    <list>
                        <field name="partner_id" />
                        <field name="vat" />
                        <field name="country_code" />
                        <field name="currency_id" column_invisible="1" />
                        <field name="amount_products" sum="Total" />
                        <field name="amount_services" sum="Total" />
                    </list>
                </field>
            </group>
        </field>
    </record>
</odoo>
