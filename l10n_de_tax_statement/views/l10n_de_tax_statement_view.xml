<odoo>
    <record id="view_l10n_de_tax_statement_form" model="ir.ui.view">
        <field name="model">l10n.de.tax.statement</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button
                        name="action_update"
                        string="Update"
                        type="object"
                        invisible="state != 'draft'"
                    />
                    <button
                        name="action_approve"
                        string="Approve"
                        type="object"
                        class="btn-primary"
                        groups="account.group_account_manager"
                        invisible="state != 'draft' or is_period_open"
                    />
                    <!-- the same button, asking first as the period isn't locked -->
                    <button
                        name="action_approve"
                        string="Approve"
                        type="object"
                        class="btn-primary"
                        groups="account.group_account_manager"
                        invisible="state != 'draft' or not is_period_open"
                        confirm="The period isn't locked: the tax return lock date of the company is before its end, so journal items can still be posted into it. Approve the statement anyway?"
                    />
                    <field name="state" widget="statusbar" />
                </header>
                <sheet>
                    <div
                        class="alert alert-warning"
                        role="alert"
                        invisible="not is_period_open"
                    >
                        The period isn't closed: the tax return lock date of the
                        company is before its end, so journal items can still be
                        posted into it. Set the tax return lock date to the end
                        of the period once the statement is complete.
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1" />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field
                                name="year"
                                options="{'format': false}"
                                readonly="state != 'draft'"
                            />
                            <field name="period" readonly="state != 'draft'" />
                            <field name="is_corrected" readonly="state != 'draft'" />
                        </group>
                        <group>
                            <field
                                name="company_id"
                                groups="base.group_multi_company"
                            />
                            <field name="date_from" />
                            <field name="date_to" />
                        </group>
                    </group>
                    <field
                        name="line_ids"
                        widget="section_and_note_one2many"
                        readonly="state != 'draft'"
                    >
                        <list
                            editable="bottom"
                            create="false"
                            delete="false"
                            limit="100"
                        >
                            <field name="display_type" column_invisible="1" />
                            <field name="base_tag" column_invisible="1" />
                            <field name="tax_tag" column_invisible="1" />
                            <field name="currency_id" column_invisible="1" />
                            <field name="name" readonly="1" />
                            <field name="base_code" readonly="1" />
                            <field name="base" invisible="not base_tag" readonly="1" />
                            <button
                                name="action_view_base_items"
                                type="object"
                                title="Journal Items"
                                icon="fa-search-plus"
                                invisible="not base_tag"
                            />
                            <field name="tax_code" readonly="1" />
                            <field name="tax" invisible="not tax_tag" readonly="1" />
                            <button
                                name="action_view_tax_items"
                                type="object"
                                title="Journal Items"
                                icon="fa-search-plus"
                                invisible="not tax_tag"
                            />
                        </list>
                    </field>
                    <group name="tax_total" class="oe_subtotal_footer">
                        <field name="tax_total" />
                    </group>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>
    <record id="view_l10n_de_tax_statement_list" model="ir.ui.view">
        <field name="model">l10n.de.tax.statement</field>
        <field name="arch" type="xml">
            <list decoration-info="state == 'draft'">
                <field name="name" />
                <field name="date_from" />
                <field name="date_to" />
                <field name="tax_total" />
                <field name="company_id" groups="base.group_multi_company" />
                <field name="state" />
            </list>
        </field>
    </record>
    <record id="action_l10n_de_tax_statement" model="ir.actions.act_window">
        <field name="name">German VAT Statement</field>
        <field name="res_model">l10n.de.tax.statement</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem
        id="menu_l10n_de_tax_statement"
        parent="account.menu_finance_reports"
        groups="account.group_account_user"
        action="action_l10n_de_tax_statement"
    />
</odoo>
