<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <block name="default_taxes_setting_container" position="after">
                <block title="ELSTER" name="l10n_de_elster_setting_container">
                    <setting
                        id="l10n_de_elster_hersteller_id"
                        help="The HerstellerID ELSTER assigned to the manufacturer of the software, the XML export of the German VAT Statement needs it."
                    >
                        <field name="l10n_de_elster_hersteller_id" />
                    </setting>
                </block>
            </block>
        </field>
    </record>
</odoo>
