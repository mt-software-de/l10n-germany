<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="model">res.config.settings</field>
        <field
            name="inherit_id"
            ref="l10n_de_tax_statement.res_config_settings_view_form"
        />
        <field name="arch" type="xml">
            <setting id="l10n_de_elster_hersteller_id" position="after">
                <setting
                    id="l10n_de_eric_test"
                    help="Send the statements as test cases: ELSTER deletes them right after their receipt, they aren't declared."
                >
                    <field name="l10n_de_eric_test" />
                </setting>
                <setting
                    id="l10n_de_eric_store_certificate"
                    help="Keep the certificate file of Mein ELSTER and its PIN in the database, only administrators can read them. The approval of a statement then sends it right away."
                >
                    <field name="l10n_de_eric_store_certificate" />
                    <div
                        class="content-group mt16"
                        invisible="not l10n_de_eric_store_certificate"
                    >
                        <field
                            name="l10n_de_eric_certificate"
                            filename="l10n_de_eric_certificate_name"
                        />
                        <field name="l10n_de_eric_certificate_name" invisible="1" />
                        <div class="mt8">
                            <label for="l10n_de_eric_pin" class="me-2" />
                            <field name="l10n_de_eric_pin" password="True" />
                        </div>
                        <div class="mt8">
                            <field
                                name="l10n_de_eric_privacy_notice"
                                nolabel="1"
                                class="text-muted"
                            />
                        </div>
                        <div>
                            <field name="l10n_de_eric_privacy_notice_read" />
                            <label for="l10n_de_eric_privacy_notice_read" />
                        </div>
                    </div>
                </setting>
            </setting>
        </field>
    </record>
</odoo>
