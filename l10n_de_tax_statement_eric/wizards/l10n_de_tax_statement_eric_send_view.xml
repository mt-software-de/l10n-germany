<odoo>
    <record id="view_l10n_de_tax_statement_eric_send_form" model="ir.ui.view">
        <field name="model">l10n.de.tax.statement.eric.send</field>
        <field name="arch" type="xml">
            <form string="Send to ELSTER">
                <div class="alert alert-info" role="alert" invisible="not is_test">
                    Test transmission: ELSTER deletes the declaration right after
                    its receipt, it isn't declared.
                </div>
                <group>
                    <field name="statement_id" readonly="1" />
                    <field name="declaration" readonly="1" />
                    <field name="is_test" invisible="1" />
                    <field
                        name="certificate"
                        filename="certificate_name"
                        required="1"
                    />
                    <field name="certificate_name" invisible="1" />
                    <field name="pin" password="True" required="1" />
                </group>
                <separator string="Datenschutzhinweis der Finanzverwaltung" />
                <field name="privacy_notice" nolabel="1" />
                <group>
                    <field name="privacy_notice_read" />
                </group>
                <footer>
                    <button
                        name="action_send"
                        string="Send"
                        type="object"
                        class="btn-primary"
                        invisible="not privacy_notice_read"
                    />
                    <button string="Cancel" special="cancel" />
                </footer>
            </form>
        </field>
    </record>
</odoo>
